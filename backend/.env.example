# Database configuration
DATABASE_URL=postgresql://quickdesk:quickdesk@localhost:5433/quickdesk

# Security & JWT
JWT_SECRET_KEY=change_me_to_a_secure_random_secret_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Options: "huggingface", "groq", "mock")
AI_PROVIDER=mock
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-3B-Instruct
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
